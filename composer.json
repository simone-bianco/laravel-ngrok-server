{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simone-bianco/laravel-ngrok-server",
    "description": "Laravel-owned, safety-first ngrok supervisor and runtime primitives.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/process": "^7.4.5 || ^8.0.5"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-ffi": "Required on Windows for handle-bound Job Object process ownership."
    },
    "autoload": {
        "psr-4": {
            "SimoneBianco\\LaravelNgrokServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimoneBianco\\LaravelNgrokServer\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Support/NgrokRuntimeFakes.php"
        ]
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/pint",
        "format:test": "@php vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimoneBianco\\LaravelNgrokServer\\LaravelNgrokServerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
